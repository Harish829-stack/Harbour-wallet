-        {err && <Btn variant="ghost" onClick={() => void load()}>Try again</Btn>}
-        <Btn disabled={!canMigrate(s) || busy} onClick={go} style={{ marginTop: 14 }}>{busy ? 'Preparing…' : 'Move selected assets'}</Btn>
       </>}
     </Screen>
   );
