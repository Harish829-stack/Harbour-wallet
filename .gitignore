# ---- dependencies (any depth) ----
node_modules/

# ---- build output and archived builds (any depth) ----
dist/
dist.*/
build/
*.tsbuildinfo
coverage/

# ---- generated by harbour-wallet-v2's build ----
harbour-wallet-v2/public-production/inpage.js
harbour-wallet-v2/public-production/public-content.js
harbour-wallet-v2/public-production/wallet-core.wasm

# ---- secrets / local environment ----
.env
.env.*
!.env.example

# ---- network captures: session tokens, device IDs, very large ----
*.har
/evidences/network-logs/

# ---- binary archives and packaged extensions ----
*.zip
*.tgz
*.tar.gz
*.crx
*.pem

# ---- third-party material that is re-fetchable and should not be republished ----
# The supplied Trust Wallet extension (original package + extracted copy). Provenance/hashes live in trust-wallet-RE.md and evidence/INDEX.md.
/evidences/extension/
# Upstream clone of trustwallet/wallet-core (pinned dependency, see AGENTS.md); has its own .git
/evidences/reference/wallet-core/
# Local analysis toolchain: downloaded browsers, compilers, vendored REA/WABT clones, module caches. Keep only the scripts in tools/.
/tools/browsers/
/tools/toolchain/
/tools/vendor/
/tools/darwin-module-cache/

# ---- scratch / tool work dirs ----
.rea-work/
*.log
npm-debug.log*

# ---- OS / editor ----
.DS_Store
.idea/
.vscode/
*.swp

harbour-keys.env
harbour-config-key.json

# ---- signing / service-account keys (never commit) ----
harbour-release-key.json
*firebase-adminsdk*.json
*-adminsdk-*.json

# Cloudflare Worker local secrets
.dev.vars
.wrangler/
