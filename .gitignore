# =====================================================================
# Repository-wide ignores. App-specific ignores live beside each app:
#   harbour-wallet-v3/apps/extension/.gitignore
#   harbour-wallet-v3/apps/backend/.gitignore
# =====================================================================

# ---- dependencies and build output ----
node_modules/
dist/
dist.*/
build/
coverage/
*.tsbuildinfo

# ---- secrets and local environment (never commit) ----
.env
.env.*
!.env.example
harbour-keys.env
harbour-config-key.json
harbour-release-key.json
*firebase-adminsdk*.json
*-adminsdk-*.json
*.pem
.dev.vars
.wrangler/

# ---- network captures: session tokens, device IDs, very large ----
*.har
*.mitm
*.3novlog
/research/evidences/network-logs/

# ---- binary archives and packaged extensions ----
*.zip
*.tgz
*.tar.gz
*.crx

# ---- third-party material that is re-fetchable and should not be republished ----
# The supplied Trust Wallet extension (original package + extracted copy). Provenance/hashes live in the research notes.
/research/evidences/extension/
# Upstream clone of trustwallet/wallet-core (pinned dependency); has its own .git
/research/evidences/reference/wallet-core/
# Local analysis toolchain: downloaded browsers, compilers, vendored REA/WABT clones, module caches.
/research/tools/browsers/
/research/tools/toolchain/
/research/tools/vendor/
/research/tools/darwin-module-cache/
# Local clone of the public asset library (1+ GB, has its own .git); only the compact bundle generated by
# harbour-wallet-v3/apps/extension/scripts/import-assets.py is committed.
/assets/

# ---- security audit working files: kept local, not published ----
# Files already tracked stay tracked; new, untracked reports in this folder are not picked up by `git add`.
/documentation/harbour-v3/security/audit-v3/

# ---- scratch / tool work dirs ----
.rea-work/
*.log
npm-debug.log*
/_to_delete/

# ---- OS / editor ----
.DS_Store
.idea/
.vscode/
*.swp
