# Harbour Wallet keys. Copy this file to `harbour-keys.env`, fill in the values, and keep that copy out of git.
# Leave a line empty if you do not have that key yet; features that need it stay off.
# These go into Cloudflare secrets (the gateway) only. None of them is built into the extension.

# --- Required for the gateway ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
LIFI_API_KEY=
JUP_API_KEY=
COINGECKO_KEY=

# --- Needed for specific features ---
HELIUS_API_KEY=
ALCHEMY_API_KEY=
ETHERSCAN_API_KEY=
TRONGRID_API_KEY=
TONCENTER_API_KEY=
SUBSCAN_API_KEY=
ONRAMPER_API_KEY=

# --- Public identifier, safe to ship in the extension ---
VITE_WC_PROJECT_ID=

# --- Optional ---
PIMLICO_API_KEY=
HYPERLIQUID_BUILDER_ADDRESS=

# --- Test wallet (throwaway only). Public address is enough; never put your main wallet here. ---
TEST_WALLET_ADDRESS=

FCM_SENDER_ID=
FCM_SERVICE_ACCOUNT_FILE=
