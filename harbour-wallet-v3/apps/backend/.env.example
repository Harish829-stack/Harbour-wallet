# Harbour backend (harbour-wallet-v3/backend) environment.
# Copy to backend/.env and fill in. Never commit .env; it is gitignored.
# Values marked "generated" are created by the setup script; leave them empty.

# ---- Environment ----
APP_ENV=development            # development | staging | production
LOG_LEVEL=info                 # debug | info | warn | error

# Networks served (chains.yaml names, comma-separated). Empty = every chain in config/chains.yaml.
ENABLED_CHAINS=

# ---- Phase 1-2: RPC providers (required) ----
ALCHEMY_API_KEY=
ALCHEMY_API_KEY_2=             # optional second key, separate rate budget
INFURA_API_KEY=
INFURA_API_SECRET=             # only if "require API key secret" is on in Infura
INFURA_API_KEY_2=              # optional
# Third provider (optional now, recommended): full HTTPS endpoint URLs, key included
QUICKNODE_ETH_URL=
QUICKNODE_BASE_URL=
CHAINSTACK_ETH_URL=
CHAINSTACK_BASE_URL=

# ---- Local infrastructure (Docker Compose; generated, change only for real deployments) ----
POSTGRES_URL=postgres://harbour:@localhost:5432/harbour?sslmode=verify-full&sslrootcert=deploy/postgres/certs/ca.crt
POSTGRES_PASSWORD=             # generated (owner: migrations only)
POSTGRES_APP_PASSWORD=         # generated; the services' own login (harbour_svc, data access only)
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=                # generated
NATS_PASSWORD=                 # generated; NATS requires it
NATS_URL=nats://harbour:@localhost:4222
# Per-service logins (generated by scripts/setup.sh): Postgres users harbour_<service>, NATS users with subject permissions.
PG_PW_API=
PG_PW_INDEXER=
PG_PW_WEBHOOK=
PG_PW_PRICES=
PG_PW_TXTRACK=
PG_PW_NOTIFIER=
NATS_PW_API=
NATS_PW_INDEXER=
NATS_PW_WEBHOOK=
NATS_PW_PRICES=
NATS_PW_TXTRACK=
NATS_PW_REALTIME=
NATS_PW_NOTIFIER=
CENTRIFUGO_API_URL=http://localhost:8000/api
CENTRIFUGO_API_KEY=            # generated
CENTRIFUGO_TOKEN_HMAC_SECRET=  # generated; signs realtime (Centrifugo) JWTs

# ---- Service wiring (defaults suit `make up` and `make run-api`) ----
API_ADDR=:8080
GATEWAY_ADDR=:8081
RPC_GATEWAY_URL=http://localhost:8081
TRUST_PROXY_HEADERS=0          # 1 only behind your own load balancer
TRUSTED_PROXY_CIDRS=           # load balancer networks (default: private ranges); X-Forwarded-For is read only from these
REALTIME_PUBLIC_URL=ws://localhost:8000/connection/websocket   # must be wss:// outside local development

# ---- Server-side secrets (generated) ----
GATEWAY_INTERNAL_TOKEN=        # generated; api -> rpc-gateway bearer token
ADDRESS_LINK_ENCRYPTION_KEY=   # generated; encrypts device_addresses
POW_DIFFICULTY=20              # proof-of-work bits for device registration

# ---- Phase 3-4: Alchemy indexer ----
ALCHEMY_NOTIFY_TOKEN=          # Alchemy dashboard > Webhooks > Auth token
ALCHEMY_WEBHOOK_SIGNING_KEYS=  # comma-separated webhookId:signingKey pairs
WEBHOOK_PUBLIC_URL=            # public HTTPS URL for webhooks (ngrok / Cloudflare Tunnel in dev) 8082

# ---- Phase 5: prices ----
COINGECKO_API_KEY=
COINGECKO_PLAN=demo            # demo | pro (pro uses the paid API host)

# ---- Phase 6: realtime and push notifications ----
REALTIME_PUBLIC_URL=ws://localhost:8000/connection/websocket   # Centrifugo URL handed to the extension
VAPID_PUBLIC_KEY=              # generated with the private key below
VAPID_PRIVATE_KEY=             # generated if empty; keep secret
VAPID_SUBJECT=mailto:          # contact address for Web Push
FCM_CREDENTIALS_FILE=          # path to Firebase service-account JSON, outside the repo

# ---- Phase 7: AWS (use a local AWS profile; never put access keys here) ----
AWS_PROFILE=
AWS_REGION=

# --- Third-party gateway (/v1/gw): the extension calls these through the API; the keys never leave the backend ---
LIFI_API_KEY=
UNISWAP_API_KEY=              # Uniswap Trading API; held only by the gateway, never bundled with the extension
JUP_API_KEY=
RELAY_API_KEY=                 # optional (Relay quotes need a key from 2026-10-02)
PIMLICO_API_KEY=               # optional (gasless swaps); empty leaves /pimlico unavailable
PIMLICO_SPONSORSHIP_POLICY_ID= # sponsorship policy the gateway pins on pm_sponsorUserOperation (client context is dropped)
HELIUS_API_KEY=                # Solana RPC + DAS (tokens, NFTs, history)
ETHERSCAN_API_KEY=             # Etherscan V2: history for chains the indexer does not cover
TRONGRID_API_KEY=
TONCENTER_API_KEY=
# --- Buy / sell crypto (Onramper). Both keys empty = feature off. docs/: documentation/ramps/onramper.md
ONRAMPER_API_KEY=              # pk_prod_... or pk_test_... (pk_test_ selects the staging API unless ONRAMPER_ENV is set)
ONRAMPER_SIGNING_KEY=          # Ed25519 private key (PKCS#8 PEM; one line with \n is fine) or use ONRAMPER_SIGNING_KEY_FILE=/path/key.pem
ONRAMPER_ENV=                  # production | staging (optional)
ONRAMPER_WEBHOOK_SECRET=       # webhook-ingest: HMAC secret Onramper issues for https://<webhooks host>/webhooks/onramper
RAMPS_RETURN_URL=              # public https URL of the API's /v1/ramps/return (e.g. https://api.example.com/v1/ramps/return)
RAMPS_MAX_ORDERS_PER_HOUR=     # per device, default 20
CONFIG_JSON=                   # signed remote config text (optional) and its base64 Ed25519 signature
CONFIG_SIG=
