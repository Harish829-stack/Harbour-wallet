# Copy to .env.production (never commit real values). Public, non-secret build settings only: provider keys live in the gateway.
# Harbour backend API (backend/ in this repo). Sepolia and Base Sepolia read balances, history, NFTs and send through it.
# Must be https:// for any build you hand out; http is accepted only for localhost (local builds), and release.mjs refuses those.
VITE_HB_API_URL=http://localhost:8080
# Leave VITE_HB_GATEWAY_URL unset: third-party calls go to VITE_HB_API_URL/v1/gw (the backend holds LIFI/JUP/COINGECKO/HELIUS/ALCHEMY/ETHERSCAN/TRONGRID/TONCENTER keys in backend/.env).
# VITE_HB_GATEWAY_URL=
VITE_HB_CONFIG_PUBKEY=<base64 Ed25519 public key printed by scripts/deploy-gateway.mjs>
VITE_WC_PROJECT_ID=<Reown / WalletConnect project id>
# Server push (Firebase Cloud Messaging sender id); empty = local notification watcher only
VITE_HB_FCM_SENDER_ID=
# Hyperliquid builder code (your address) and fee in tenths of a basis point (10 = 1 bp); empty = no builder fee
VITE_HB_HL_BUILDER=
VITE_HB_HL_BUILDER_FEE=10
# Polymarket builder code (bytes32 from your Builder Profile); empty = no attribution
VITE_HB_PM_BUILDER_CODE=
