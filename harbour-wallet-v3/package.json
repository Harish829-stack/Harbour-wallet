    "@ledgerhq/hw-transport-webhid": "6.36.0",
    "@msgpack/msgpack": "3.1.3",
    "@mysten/sui": "1.45.2",
    "@ngraveio/bc-ur": "1.1.13",
    "@noble/hashes": "1.5.0",
    "@polkadot/api": "16.5.6",
