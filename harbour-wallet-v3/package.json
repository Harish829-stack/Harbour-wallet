{
  "name": "harbour-wallet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Harbour Wallet \u2014 MV3 crypto wallet (RE-aligned with Trust Wallet; wallet-core crypto)",
  "scripts": {
    "dev": "vite",
