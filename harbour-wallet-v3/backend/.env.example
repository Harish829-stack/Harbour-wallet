# Harbour backend (harbour-wallet-v3/backend) environment.
# Copy to backend/.env and fill in. Never commit .env; it is gitignored.
# Values marked "generated" are created by the setup script; leave them empty.

# ---- Environment ----
APP_ENV=development            # development | staging | production
LOG_LEVEL=info                 # debug | info | warn | error

# Networks served (chains.yaml names, comma-separated). Empty = every chain in config/chains.yaml.
ENABLED_CHAINS=sepolia,base-sepolia

# ---- Phase 1-2: RPC providers (required) ----
ALCHEMY_API_KEY=
ALCHEMY_API_KEY_2=             # optional second key, separate rate budget
INFURA_API_KEY=
INFURA_API_SECRET=             # only if "require API key secret" is on in Infura
INFURA_API_KEY_2=              # optional
# Third provider (optional now, recommended): full HTTPS endpoint URLs, key included
QUICKNODE_ETH_URL=
QUICKNODE_BASE_URL=
CHAINSTACK_ETH_URL=
CHAINSTACK_BASE_URL=

# ---- Local infrastructure (Docker Compose; generated, change only for real deployments) ----
POSTGRES_URL=postgres://harbour:@localhost:5432/harbour?sslmode=disable
POSTGRES_PASSWORD=             # generated
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=                # generated
NATS_URL=nats://localhost:4222
CENTRIFUGO_API_URL=http://localhost:8000/api
CENTRIFUGO_API_KEY=            # generated
CENTRIFUGO_TOKEN_HMAC_SECRET=  # generated; signs realtime (Centrifugo) JWTs

# ---- Service wiring (defaults suit `make up` and `make run-api`) ----
API_ADDR=:8080
GATEWAY_ADDR=:8081
RPC_GATEWAY_URL=http://localhost:8081
TRUST_PROXY_HEADERS=0          # 1 only behind your own load balancer

# ---- Server-side secrets (generated) ----
GATEWAY_INTERNAL_TOKEN=        # generated; api -> rpc-gateway bearer token
ADDRESS_LINK_ENCRYPTION_KEY=   # generated; encrypts device_addresses
POW_DIFFICULTY=20              # proof-of-work bits for device registration

# ---- Phase 3-4: Alchemy indexer ----
ALCHEMY_NOTIFY_TOKEN=          # Alchemy dashboard > Webhooks > Auth token
ALCHEMY_WEBHOOK_SIGNING_KEYS=  # comma-separated webhookId:signingKey pairs
WEBHOOK_PUBLIC_URL=            # public HTTPS URL for webhooks (ngrok / Cloudflare Tunnel in dev)

# ---- Phase 5: prices ----
COINGECKO_API_KEY=
COINGECKO_PLAN=demo            # demo | pro (pro uses the paid API host)

# ---- Phase 6: realtime and push notifications ----
REALTIME_PUBLIC_URL=ws://localhost:8000/connection/websocket   # Centrifugo URL handed to the extension
VAPID_PUBLIC_KEY=              # generated with the private key below
VAPID_PRIVATE_KEY=             # generated if empty; keep secret
VAPID_SUBJECT=mailto:          # contact address for Web Push
FCM_CREDENTIALS_FILE=          # path to Firebase service-account JSON, outside the repo

# ---- Phase 7: AWS (use a local AWS profile; never put access keys here) ----
AWS_PROFILE=
AWS_REGION=
